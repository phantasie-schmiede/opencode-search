#!/usr/bin/env php
<?php

declare(strict_types=1);

// opencode-search: full-text search across all OpenCode sessions.
// Queries the local opencode SQLite database (read-only) and either lists
// the matching sessions or prints the matching lines of one session.

// Max. number of sessions printed in list mode.
const DEFAULT_LIMIT   = 20;
// Context lines around each match in --show mode.
const DEFAULT_CONTEXT = 2;
// Lines longer than this are truncated in --show output.
const MAX_LINE_WIDTH  = 160;
// Bump on every release.
const VERSION         = '1.0.0';

// Print an error message and terminate (exit code 2 unless overridden).
function fail(string $msg, int $code = 2): never
{
    fwrite(STDERR, 'Error: ' . $msg . "\n");
    exit($code);
}

function help(): void
{
    echo <<<TXT
opencode-search – full-text search across all OpenCode sessions

Usage:
  opencode-search <keyword> [options]
  opencode-search -- <keyword starting with ->

Options:
  -s, --show SESSID    Show matching lines of a session with context
                       (SESSID: full ID or unique prefix)
  -l, --limit N        Max. number of sessions in the list (default: 20)
  -c, --context N      Context lines per match for --show (default: 2)
      --text-only      Search text parts only (no tool output)
  -p, --project DIR    Filter by project/directory name (substring)
      --since DATE     Only sessions from DATE on (YYYY-MM-DD or -Nd, e.g. -14d)
      --json           Output as JSON (list mode only)
      --resume         Show the opencode --session command per session
  -q, --quiet          Print session IDs only
  -V, --version        Print the version and exit
  -h, --help           This help

Exit status:  0 = matches found, 1 = no matches, 2 = error

Examples:
  opencode-search "asset:publish"
  opencode-search "asset:publish" --since -7d --resume
  opencode-search "Could not determine path" --show ses_ec4671
  opencode-search vendor/bin/crafter --json
TXT;
}

// Fetch the value that must follow an option; reject missing or flag-like values.
function needValue(array $args, int $i, string $flag): string
{
    if (!isset($args[$i]) || str_starts_with($args[$i], '-')) {
        fail('Option ' . $flag . ' requires a value');
    }

    return $args[$i];
}

function parseArgs(array $argv): array
{
    $opts = [
        'context'   => DEFAULT_CONTEXT,
        'json'      => false,
        'keyword'   => null,
        'limit'     => DEFAULT_LIMIT,
        'project'   => null,
        'quiet'     => false,
        'resume'    => false,
        'show'      => null,
        'since'     => null,
        'textOnly'  => false,
    ];
    $args = array_slice($argv, 1);
    // Tracks whether "--" was seen; only the keyword may follow it.
    $positional = false;

    for ($i = 0, $n = count($args); $i < $n; $i++) {
        $arg = $args[$i];

        if ($positional) {
            fail('Unexpected argument: ' . $arg . ' (see --help)');
        }

        // "--" marks the keyword, allowing it to start with a dash.
        if ($arg === '--') {
            $positional = true;
            if ($i + 1 >= $n) {
                fail('Missing search keyword');
            }
            $opts['keyword'] = $args[++$i];

            continue;
        }

        switch ($arg) {
            case '-V':
            case '--version':
                echo 'opencode-search ' . VERSION . "\n";
                exit(0);
            case '-h':
            case '--help':
                help();
                exit(0);
            case '-s':
            case '--show':
                $opts['show'] = needValue($args, ++$i, $arg);
                break;
            case '-l':
            case '--limit':
                $opts['limit'] = (int) needValue($args, ++$i, $arg);
                break;
            case '-c':
            case '--context':
                $opts['context'] = (int) needValue($args, ++$i, $arg);
                break;
            case '-p':
            case '--project':
                $opts['project'] = needValue($args, ++$i, $arg);
                break;
            case '--since':
                if (!isset($args[$i + 1])) {
                    fail('Option --since requires a value');
                }
                $opts['since'] = $args[++$i];
                break;
            case '--text-only':
                $opts['textOnly'] = true;
                break;
            case '--json':
                $opts['json'] = true;
                break;
            case '--resume':
                $opts['resume'] = true;
                break;
            case '-q':
            case '--quiet':
                $opts['quiet'] = true;
                break;
            default:
                // First non-flag token is the keyword; anything after is an error.
                if ($opts['keyword'] === null) {
                    $opts['keyword'] = $arg;

                    break;
                }
                fail('Unexpected argument: ' . $arg . ' (see --help)');
        }
    }

    // Validate: keyword required, sane ranges, no conflicting modes.
    if ($opts['keyword'] === null || $opts['keyword'] === '') {
        help();
        exit(2);
    }
    if ($opts['limit'] < 1) {
        fail('--limit must be at least 1');
    }
    if ($opts['context'] < 0) {
        fail('--context must be 0 or greater');
    }
    if ($opts['json'] && $opts['show'] !== null) {
        fail('--json is only available in list mode (without --show)');
    }

    return $opts;
}

// Escape LIKE wildcards so the keyword matches literally (used with ESCAPE '\').
function escapeLike(string $value): string
{
    return str_replace(['\\', '%', '_'], ['\\\\', '\\%', '\\_'], $value);
}

// Convert --since (absolute date or relative "-Nd") to epoch milliseconds;
// opencode stores times in milliseconds.
function sinceEpochMs(?string $since): ?int
{
    if ($since === null) {
        return null;
    }
    if (preg_match('/^-(\d+)d$/', $since, $m)) {
        return (time() - ((int) $m[1] * 86400)) * 1000;
    }
    $ts = strtotime($since);
    if ($ts === false) {
        fail('Invalid date for --since: ' . $since . ' (YYYY-MM-DD or -Nd)');
    }

    return $ts * 1000;
}

function openDb(): PDO
{
    $path = null;

    // Prefer the path the opencode binary itself reports...
    $out = @shell_exec('opencode db path 2>/dev/null');
    if ($out !== null && $out !== false) {
        $candidate = trim($out);
        if ($candidate !== '' && is_file($candidate)) {
            $path = $candidate;
        }
    }
    // ...fall back to the standard location (also used when opencode is not on PATH).
    $path ??= rtrim($_SERVER['HOME'] ?? '', '/') . '/.local/share/opencode/opencode.db';

    if (!is_file($path)) {
        fail('Opencode database not found: ' . $path);
    }

    // Open strictly read-only; the tool must never modify the database.
    $db = new PDO('sqlite:file:' . $path . '?mode=ro');
    $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    return $db;
}

// Build the shared WHERE fragments for list queries.
function filterSql(bool $textOnly, ?string $project, ?int $sinceMs): string
{
    $sql = '';
    if ($textOnly) {
        $sql .= " AND json_extract(p.data, '\$.type') = 'text'";
    }
    if ($project !== null) {
        $sql .= ' AND s.directory LIKE :project ESCAPE \'\\\'';
    }
    if ($sinceMs !== null) {
        $sql .= ' AND s.time_created >= :since';
    }

    return $sql;
}

function runList(array $opts, PDO $db): void
{
    $sinceMs = sinceEpochMs($opts['since']);

    // Count matching parts per session; one row per session.
    $sql = "SELECT s.id, s.title, s.directory, s.time_created, count(*) AS hits
            FROM part p
            JOIN session s ON s.id = p.session_id
            WHERE p.data LIKE :kw ESCAPE '\\'";
    $sql .= filterSql($opts['textOnly'], $opts['project'], $sinceMs);
    $sql .= ' GROUP BY s.id
             ORDER BY hits DESC, s.time_updated DESC
             LIMIT ' . (int) $opts['limit'];

    // Bind parameters; % and _ in keyword/project stay literal (escapeLike).
    $stmt = $db->prepare($sql);
    $stmt->bindValue(':kw', '%' . escapeLike($opts['keyword']) . '%', PDO::PARAM_STR);
    if ($opts['project'] !== null) {
        $stmt->bindValue(':project', '%' . escapeLike($opts['project']) . '%', PDO::PARAM_STR);
    }
    if ($sinceMs !== null) {
        $stmt->bindValue(':since', $sinceMs, PDO::PARAM_INT);
    }
    $stmt->execute();

    $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);

    // Output mode: JSON payload for scripting.
    if ($opts['json']) {
        $sessions = array_map(static fn (array $r): array => [
            'created'   => date('c', (int) ($r['time_created'] / 1000)),
            'directory' => (string) $r['directory'],
            'hits'      => (int) $r['hits'],
            'id'        => (string) $r['id'],
            'title'     => (string) $r['title'],
        ], $rows);
        echo json_encode([
            'count'    => count($sessions),
            'keyword'  => $opts['keyword'],
            'sessions' => $sessions,
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";

        exit($rows ? 0 : 1);
    }

    // Output mode: bare session IDs for pipes.
    if ($opts['quiet']) {
        foreach ($rows as $row) {
            echo $row['id'], "\n";
        }

        exit($rows ? 0 : 1);
    }

    // No matches: exit 1 (documented, scriptable).
    if (!$rows) {
        exit(1);
    }

    // Output mode: human-readable table.
    foreach ($rows as $row) {
        echo str_pad((string) $row['hits'], 6, ' ', STR_PAD_LEFT), '  ',
            date('Y-m-d H:i', (int) ($row['time_created'] / 1000)), '  ',
            $row['id'], '  ',
            $row['title'], "\n";
        if ($opts['resume']) {
            echo str_repeat(' ', 24), '→ opencode --session ', $row['id'], "\n";
        }
    }

    exit(0);
}

// Resolve a session from a full ID or a unique prefix.
function resolveSession(PDO $db, string $id): ?array
{
    // Try the full ID first.
    $stmt = $db->prepare('SELECT id, title FROM session WHERE id = :id');
    $stmt->execute([':id' => $id]);
    if ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
        return $row;
    }
    // Prefix search only for plausible IDs (short prefixes are almost always ambiguous).
    if (strlen($id) < 8) {
        return null;
    }

    // Resolve a unique prefix (LIMIT 2 detects ambiguity).
    $stmt = $db->prepare('SELECT id, title FROM session WHERE id LIKE :prefix LIMIT 2');
    $stmt->execute([':prefix' => $id . '%']);
    $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);

    if (count($rows) === 1) {
        return $rows[0];
    }

    fail(count($rows) === 0
        ? 'Session not found: ' . $id
        : 'Ambiguous session prefix: ' . $id);
}

// Wrap every occurrence of the keyword in bold ANSI escapes (TTY output only).
function highlightLine(string $line, string $kw, bool $color): string
{
    if (!$color) {
        return $line;
    }

    // Rebuild the line, switching bold on/off around each match.
    $out = '';
    $pos = 0;
    $kwl = mb_strlen($kw);
    while (($i = mb_stripos($line, $kw, $pos)) !== false) {
        $out .= mb_substr($line, $pos, $i - $pos);
        $out .= "\033[1m" . mb_substr($line, $i, $kwl) . "\033[22m";
        $pos = $i + $kwl;
    }

    return $out . mb_substr($line, $pos);
}

// Flatten control characters and truncate very long lines.
function clipLine(string $line): string
{
    $line = str_replace(["\r", "\t"], ' ', $line);
    if (mb_strlen($line) <= MAX_LINE_WIDTH) {
        return $line;
    }

    return mb_substr($line, 0, MAX_LINE_WIDTH) . '…';
}

// Render matching lines with context, a ">" marker, and gap ellipses.
function printWindows(array $lines, string $kw, int $context, bool $color): void
{
    // Collect line indices containing the keyword.
    $hits = [];
    foreach ($lines as $idx => $line) {
        if (stripos($line, $kw) !== false) {
            $hits[] = $idx;
        }
    }

    // Merge overlapping or adjacent context ranges into windows.
    $windows = [];
    foreach ($hits as $hit) {
        $start = max(0, $hit - $context);
        $end   = min(count($lines) - 1, $hit + $context);

        if ($windows && $start <= $windows[count($windows) - 1][1] + 1) {
            $windows[count($windows) - 1][1] = max($windows[count($windows) - 1][1], $end);
        } else {
            $windows[] = [$start, $end];
        }
    }

    // Print each window; insert an ellipsis when lines are skipped between windows.
    $width = (string) count($lines);
    $last  = null;
    foreach ($windows as [$start, $end]) {
        if ($last !== null && $start > $last + 1) {
            echo "      …\n";
        }
        for ($i = $start; $i <= $end; $i++) {
            $line = $lines[$i];
            $marker = stripos($line, $kw) !== false ? '>' : ' ';
            echo '   ', $marker, ' ', str_pad((string) ($i + 1), strlen($width), ' ', STR_PAD_LEFT), '  ',
                clipLine(highlightLine($line, $kw, $color)), "\n";
        }
        $last = $end;
    }
}

function runShow(array $opts, PDO $db): void
{
    // Resolve the target session (full ID or unique prefix).
    $session = resolveSession($db, $opts['show']);
    if ($session === null) {
        fail('Session not found: ' . $opts['show']);
    }

    $sinceMs = sinceEpochMs($opts['since']);

    // Fetch matching parts of that session; the message role drives the label.
    $sql = "SELECT p.id, p.data, p.time_created, json_extract(m.data, '\$.role') AS role
            FROM part p
            JOIN message m ON m.id = p.message_id
            WHERE p.session_id = :sid AND p.data LIKE :kw ESCAPE '\\'";
    if ($opts['textOnly']) {
        $sql .= " AND json_extract(p.data, '\$.type') = 'text'";
    }
    if ($sinceMs !== null) {
        $sql .= ' AND p.time_created >= :since';
    }
    $sql .= ' ORDER BY p.time_created';

    $stmt = $db->prepare($sql);
    $stmt->bindValue(':sid', $session['id'], PDO::PARAM_STR);
    $stmt->bindValue(':kw', '%' . escapeLike($opts['keyword']) . '%', PDO::PARAM_STR);
    if ($sinceMs !== null) {
        $stmt->bindValue(':since', $sinceMs, PDO::PARAM_INT);
    }
    $stmt->execute();

    $parts = $stmt->fetchAll(PDO::FETCH_ASSOC);

    // Session header.
    echo $session['id'], ' — ', $session['title'], "\n";
    echo str_repeat('─', max(40, mb_strlen($session['id'] . ' — ' . $session['title']))), "\n";

    if (!$parts) {
        echo 'No matches in this session.', "\n";

        exit(1);
    }

    // Color output only when stdout is a terminal.
    $color = function_exists('stream_isatty') && @stream_isatty(STDOUT);
    $shown = 0;

    // Extract display text and a role label from each part's JSON.
    foreach ($parts as $part) {
        $data = json_decode((string) $part['data'], true);
        if (!is_array($data)) {
            continue;
        }

        $type = (string) ($data['type'] ?? '');
        $role = (string) ($part['role'] ?? '?');

        if ($type === 'text') {
            $text  = (string) ($data['text'] ?? '');
            $label = $role;
        } elseif ($type === 'tool') {
            $text  = (string) ($data['state']['output'] ?? $data['state']['error'] ?? '');
            $label = 'tool:' . (string) ($data['tool'] ?? '?');
        } else {
            $text  = (string) ($data['text'] ?? '');
            $label = $type !== '' ? $type : $role;
        }

        // Skip parts without extractable text.
        if ($text === '') {
            continue;
        }

        $shown++;
        echo "\n[", date('Y-m-d H:i', (int) ($part['time_created'] / 1000)), '] ', $label, "\n";
        printWindows(preg_split('/\n/', $text), (string) $opts['keyword'], $opts['context'], $color);
    }

    // Matches existed but none could be rendered (e.g. non-extractable parts).
    if ($shown === 0) {
        echo 'No displayable matches (matches are in non-extractable parts).', "\n";
    }

    exit(0);
}

function main(array $argv): void
{
    $opts = parseArgs($argv);
    $db   = openDb();

    // Show mode exits internally; list mode is the fallback.
    if ($opts['show'] !== null) {
        runShow($opts, $db);
    }

    runList($opts, $db);
}

main($argv);
